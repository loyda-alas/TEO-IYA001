; CALCULADORA

    JMP start

frase: DB "resultado: ", 0

start:
    MOV A, 5
    MOV B, 3
    ADD A, B
    MOV C, A
    MOV B, C

    ; Imprimir la frase
    MOV C, frase
    MOV D, 0xE8
    CALL print

    ; Imprimir el resultado
    MOV A, B
    ADD A, 48
    MOV [D], A

    HLT

; SUBRUTINA PRINT
print:
    PUSH A
    PUSH B
    MOV B, 0

.loop:
    MOV A, [C]
    MOV [D], A
    INC C
    INC D
    CMP B, [C]
    JNZ .loop

    POP B
    POP A
    RET
